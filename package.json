{
  "private": true,
  "name": "klear360",
  "author": "Klear",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=18.12.1"
  },
  "workspaces": {
    "packages": [
      "packages/klear360",
      "packages/klear360-core",
      "packages/eslint-plugin-klear360",
      "packages/klear360-i18n",
      "packages/klear360-i18n-react",
      "packages/klear360-mcp"
    ],
    "nohoist": [
      "@klear/klear360/**"
    ]
  },
  "scripts": {
    "tsc:klear360": "yarn workspace @klear/klear360 typecheck",
    "tsc:knowledgebase": "node ./scripts/lintKnowledgebase.js",
    "lint": "eslint --ext js,jsx,ts,tsx packages && stylelint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --ext js,jsx,ts,tsx packages --fix && stylelint '**/*.{js,jsx,ts,tsx}' --fix",
    "lint:klear360": "eslint --ext js,jsx,ts,tsx packages/klear360",
    "lint:klear360-core": "eslint --ext js,jsx,ts,tsx packages/klear360-core",
    "lint:klear360-mcp": "NODE_OPTIONS=--max-old-space-size=8192 eslint --ext js,jsx,ts,tsx packages/klear360-mcp",
    "lint:eslint-plugin": "eslint --ext js,jsx,ts,tsx packages/eslint-plugin-klear360",
    "lint:stylelint": "stylelint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix:klear360": "eslint --ext js,jsx,ts,tsx packages/klear360 --fix",
    "lint:fix:klear360-core": "eslint --ext js,jsx,ts,tsx packages/klear360-core --fix",
    "lint:fix:klear360-mcp": "NODE_OPTIONS=--max-old-space-size=8192 eslint --ext js,jsx,ts,tsx packages/klear360-mcp --fix",
    "lint:fix:eslint-plugin": "eslint --ext js,jsx,ts,tsx packages/eslint-plugin-klear360 --fix",
    "lint:fix:stylelint": "stylelint '**/*.{js,jsx,ts,tsx}' --fix",
    "postinstall": "yarn build:eslint-plugin-klear360",
    "reinstall": "rm -rf packages/klear360-core/node_modules && yarn install",
    "build": "npm-run-all --parallel build:*",
    "build:klear360": "yarn workspace @klear/klear360 build",
    "build:klear360-core": "yarn workspace @klear/klear360-core build",
    "build:klear360-mcp": "yarn workspace @klear/klear360-mcp build",
    "build:eslint-plugin-klear360": "yarn workspace eslint-plugin-klear360 build",
    "generate-docs-lockfile": "node packages/klear360/scripts/generateDocsLockFile.mjs",
    "aicodemod:serve": "node packages/klear360/codemods/aicodemod/server.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.21.8",
    "@babel/eslint-parser": "7.21.8",
    "@types/jest": "26.0.23",
    "@types/react": "18.2.24",
    "@typescript-eslint/eslint-plugin": "5.59.6",
    "@typescript-eslint/parser": "5.59.6",
    "@typescript-eslint/utils": "5.59.6",
    "chalk": "4.1.1",
    "eslint": "8.40.0",
    "eslint-config-kentcdodds": "18.0.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-mdx": "2.1.0",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-native-a11y": "3.3.0",
    "eslint-plugin-storybook": "10.2.16",
    "execa": "5.1.0",
    "figures": "3.2.0",
    "glob": "10.4.5",
    "husky": "4.2.3",
    "lint-staged": "10.5.4",
    "npm-run-all": "4.1.5",
    "nyc": "15.1.0",
    "prettier": "2.2.1",
    "shelljs": "0.8.5",
    "stylelint": "13.13.1",
    "stylelint-config-recommended": "5.0.0",
    "stylelint-config-styled-components": "0.1.1",
    "stylelint-processor-styled-components": "1.10.0",
    "ts-morph": "26.0.0",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "react-dom": "18.2.0",
    "react": "18.2.0",
    "@types/react": "18.2.24",
    "@types/styled-components": "5.1.34",
    "styled-components": "^5",
    "framer-motion": "11.12.0",
    "@octokit/rest": "21.0.2",
    "form-data": "^4.0.0",
    "fast-xml-parser": "^4.5.0",
    "shell-quote": "^1.8.2",
    "http-proxy-middleware": "2.0.10",
    "hono": "4.12.25",
    "vite": "6.4.3",
    "@hono/node-server": "1.19.13",
    "handlebars": "4.7.9",
    "yaml": "1.10.3",
    "trim": "0.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.(json|js|jsx|ts|tsx)": [
      "prettier --write"
    ]
  },
  "overrides": {
    "http-proxy-middleware": "2.0.10",
    "hono": "4.12.25",
    "vite": "6.4.3",
    "@hono/node-server": "1.19.13",
    "handlebars": "4.7.9",
    "yaml": "1.10.3",
    "trim": "0.0.3"
  }
}
