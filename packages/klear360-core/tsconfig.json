{
  "extends": "../../tsconfig.json",
  "include": ["src", "src/@types"],
  "exclude": [
    "**/*.native.ts",
    "**/*.native.tsx",
    "src/tokens/theme/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "baseUrl": ".",
    "paths": {
      "~utils": ["src/utils"],
      "~utils/*": ["src/utils/*"],
      "~tokens/*": ["src/tokens/*"],
      "~src/*": ["src/*"]
    },
    // In Klear360 side we are targeting `.web` types
    // We can't add both `.native` & `.web` at once.
    "moduleSuffixes": [".all", ".web", ""],
    "plugins": [
      // TODO: Replace ttypescript when official compiler transforms are supported https://github.com/microsoft/TypeScript/issues/54276
      // Transform paths in output .d.ts files
      { "transform": "typescript-transform-paths", "afterDeclarations": true }
    ]
  }
}
