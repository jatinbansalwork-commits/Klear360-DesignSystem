// tsconfig for generating web types
{
  "extends": "./tsconfig-generate-types.json",
  // excluding test, stories & .native files while generating types
  "exclude": [
    "**/**.test.ts",
    "**/**.test.tsx",
    "**/**.test.js",
    "**/**.test.jsx",
    "__tests__",
    "**/**.stories.tsx",
    "**/**.stories.jsx",
    "**/**.stories.internal.tsx",
    "**/**.stories.internal.jsx",
    "**/**.native.ts",
    "**/**.native.tsx",
    "**/**.native.js",
    "**/**.native.jsx"
  ],
  "compilerOptions": {
    "declarationDir": "dist/generated-types/web",
    "moduleSuffixes": [".web", ""]
  }
}
