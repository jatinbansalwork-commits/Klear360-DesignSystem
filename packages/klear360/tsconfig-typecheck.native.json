// tsconfig only for typechecking native files
{
  "extends": "./tsconfig-generate-types.native.json",
  // overriding `exclude` and removed `**/**.test.ts` so that in CI test files get typechecked
  "exclude": [
    "**/*.stories.*",
    "**/*.stories.internal.*",
    "**/**.web.ts",
    "**/**.web.tsx",
    "**/**.web.js",
    "**/**.web.jsx",
    "**/**.web.test.ts",
    "**/**.web.test.tsx",
    "**/**.web.test.js",
    "**/**.web.test.jsx",
    "**/ThemePlayground/**/**.*",
    "**/utils/storybook/**",
    "**/storybook-recipes/**",
    "**/components/**/docs/**",
    "**/*Docs.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false
  }
}
