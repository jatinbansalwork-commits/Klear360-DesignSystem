// tsconfig for generating web types
{
  "extends": "./tsconfig-generate-types.json",
  // excluding test, stories & .native files while generating types
  "exclude": [
    "**/*.test.*",
    "__tests__",
    "**/*.stories.*",
    "**/*.stories.internal.*",
    "**/**.native.ts",
    "**/**.native.tsx",
    "**/**.native.js",
    "**/**.native.jsx",
    "**/ThemePlayground/**/**.*",
    "**/utils/storybook/**",
    "**/storybook-recipes/**",
    "**/components/**/docs/**",
    "**/*Docs.*"
  ],
  "compilerOptions": {
    "outDir": "build/generated-types/web",
    "moduleSuffixes": [".web", ""]
  }
}
