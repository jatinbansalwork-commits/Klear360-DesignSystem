// tsconfig for generating native types
{
  "extends": "./tsconfig-generate-types.json",
  // excluding test, storie & .web files while generating types
  "exclude": [
    "**/*.test.*",
    "__tests__",
    "**/*.stories.*",
    "**/*.stories.internal.*",
    "**/**.web.ts",
    "**/**.web.tsx",
    "**/**.web.js",
    "**/**.web.jsx",
    "**/ThemePlayground/**/**.*",
    "**/utils/storybook/**",
    "**/storybook-recipes/**",
    "**/components/**/docs/**",
    "**/*Docs.*"
  ],
  "compilerOptions": {
    "outDir": "build/generated-types/native",
    "moduleSuffixes": [".native", ""]
  }
}
