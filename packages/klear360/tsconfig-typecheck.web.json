// tsconfig only for typechecking web files
{
  "extends": "./tsconfig-generate-types.web.json",
  // overriding `exclude` and removed `**/**.test.ts` so that in CI test files get typechecked
  "exclude": [
    "**/*.stories.*",
    "**/*.stories.internal.*",
    "**/**.native.ts",
    "**/**.native.tsx",
    "**/**.native.js",
    "**/**.native.jsx",
    "**/**.native.test.ts",
    "**/**.native.test.tsx",
    "**/**.native.test.js",
    "**/**.native.test.jsx",
    "**/ThemePlayground/**.*",
    "**/utils/storybook/**",
    "**/storybook-recipes/**",
    "**/components/**/docs/**",
    "**/*Docs.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false
  }
}
