// Base tsconfig for type generation
{
  "extends": "./tsconfig.json",
  "exclude": [
    "**/*.test.*",
    "__tests__",
    "**/*.stories.*",
    "**/*.stories.internal.*",
    "**/utils/storybook/**",
    "**/storybook-recipes/**",
    "**/components/**/docs/**",
    "**/*Docs.*"
  ],
  "compilerOptions": {
    "declaration": true /* Generates corresponding '.d.ts' file. */,
    "emitDeclarationOnly": true /* Only output d.ts files and not JavaScript files.*/,
    "noEmit": false /* Enable emitting file from a compilation. */
  }
}
