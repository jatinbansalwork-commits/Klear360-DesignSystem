# dependencies
node_modules

# testing
coverage

# build direcotries
**/storybook-site
**/storybook-static
**/build
**/dist

# klear360-i18n and klear360-i18n-react publish their compiled output to `lib/`
# (see their package.json `main`/`module`/`types`/`files` fields) instead of
# `build`/`dist` like other packages. That compiled, committed output was never
# excluded here, so the root `eslint --ext ... packages` glob was linting the
# minified/bundled JS as if it were source - accounting for ~5650 of the ~5700
# errors in a repo-wide lint run (mangled identifiers, bundler artifacts tripping
# rules like `vars-on-top`/`func-names`/`id-match`). This gap has existed since
# the repo's initial commit; it is not something a recent dependency change broke.
**/lib

# plugin-figma-pattern-creator is not a yarn workspace member (its own package-lock.json,
# installed separately) - `yarn install` at the root never installs its devDependencies
# (e.g. @figma/eslint-plugin-figma-plugins), so the root `eslint --ext ... packages` glob
# can't lint it. It has its own `yarn lint`/`npm run lint` script for that.
packages/plugin-figma-pattern-creator/

# klear360-mcp non-code directories
packages/klear360-mcp/base-klear360-template/
packages/klear360-mcp/knowledgebase/
packages/klear360-mcp/cursorRules/
packages/klear360/components.js
packages/klear360/components.native.js
packages/klear360/components.d.ts
packages/klear360/tokens.js
packages/klear360/tokens.native.js
packages/klear360/tokens.d.ts
packages/klear360/utils.js
packages/klear360/utils.native.js
packages/klear360/utils.d.ts


# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

#error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# don't ignore dot files
!.*rc.js
