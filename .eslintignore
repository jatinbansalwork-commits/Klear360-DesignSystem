# dependencies
node_modules

# testing
coverage

# build direcotries
**/storybook-site
**/storybook-static
**/build
**/dist

# plugin-figma-pattern-creator is not a yarn workspace member (its own package-lock.json,
# installed separately) - `yarn install` at the root never installs its devDependencies
# (e.g. @figma/eslint-plugin-figma-plugins), so the root `eslint --ext ... packages` glob
# can't lint it. It has its own `yarn lint`/`npm run lint` script for that.
packages/plugin-figma-pattern-creator/

# klear360-mcp non-code directories
packages/klear360-mcp/base-klear360-template/
packages/klear360-mcp/knowledgebase/
packages/klear360-mcp/cursorRules/
packages/klear360/components.js
packages/klear360/components.native.js
packages/klear360/components.d.ts
packages/klear360/tokens.js
packages/klear360/tokens.native.js
packages/klear360/tokens.d.ts
packages/klear360/utils.js
packages/klear360/utils.native.js
packages/klear360/utils.d.ts


